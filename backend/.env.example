# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Database with pgvector (Supabase or self-hosted)
DATABASE_URL="postgresql://postgres:your_password@your_host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:your_password@your_host:5432/postgres"

# Google Gemini AI (Google AI Studio)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_whatsapp_business_account_id"
WHATSAPP_ACCESS_TOKEN="your_meta_whatsapp_access_token"
WHATSAPP_VERIFY_TOKEN="whatsapp_agent_secure_token_2026"
WHATSAPP_API_VERSION="v21.0"

# Redis Queue (Upstash or local Redis for appointment reminders)
REDIS_URL="rediss://default:your_redis_password@your_redis_host:6379"

# AI Provider Selection ('gemini' or 'ollama')
AI_PROVIDER="gemini"
