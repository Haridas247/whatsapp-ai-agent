{
  "name": "whatsapp-ai-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Tenant AI-Powered WhatsApp Business Receptionist SaaS",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "simulate": "npm --prefix backend run simulate",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:push": "npm --prefix backend run prisma:push",
    "db:seed": "npm --prefix backend run db:seed"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "keywords": [
    "whatsapp",
    "ai-agent",
    "gemini",
    "saas",
    "multi-tenant",
    "rag",
    "pgvector"
  ],
  "author": "Haridas247",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
